{% macro pageKind(url, lang) -%}
{%- if url.startsWith("/docs/") -%}{{ "home-kind-docs" | i18n({}, lang) }}
{%- elif url.startsWith("/blog/") -%}{{ "home-kind-blog" | i18n({}, lang) }}
{%- elif url.endsWith(".md") -%}{{ "home-kind-summary" | i18n({}, lang) }}
{%- else -%}simplex.chat{%- endif -%}
{%- endmacro %}

{% macro block(b, lang) %}
{% set langPrefix = '' if lang == 'en' else '/' ~ lang %}
{% if b.type == "lead" %}
<p class="lead">{{ b.text | i18n({}, lang) | inlineMarkup | safe }}</p>
{% elif b.type == "text" %}
<p class="text">{{ b.text | i18n({}, lang) | inlineMarkup | safe }}</p>
{% elif b.type == "fine" %}
<p class="fine">{{ b.text | i18n({}, lang) | inlineMarkup | safe }}</p>
{% elif b.type == "stats" %}
<div class="stats">
{% for item in b.items %}
<p class="stat"><b>{{ item.fact | factFigure(item.nth or 0) }}</b> <span>{{ item.label | i18n({}, lang) }}</span></p>
{% endfor %}
</div>
{% elif b.type == "steps" %}
<ol class="steps">
{% for item in b.items %}
<li>{{ item.text | i18n({}, lang) | inlineMarkup | safe }}</li>
{% endfor %}
</ol>
{% elif b.type == "timeline" %}
<ol class="timeline">
{% for item in b.items %}
<li><span class="when">{{ item.when | i18n({}, lang) }}</span> <b>{{ item.title | i18n({}, lang) }}</b> <span class="what">{{ item.text | i18n({}, lang) }}</span></li>
{% endfor %}
</ol>
{% elif b.type == "pages" %}
<div class="cards">
{% for item in b.items %}
<a class="card" href="{{ item.url }}"><span class="kind">{{ pageKind(item.url, lang) }}</span> <span class="title">{{ item.title | i18n({}, lang) }}</span> <span class="why">{{ item.why | i18n({}, lang) }}</span></a>
{% endfor %}
</div>
{% elif b.type == "links" %}
<p class="links">
{% for item in b.items %}
{% if item.url.startsWith("http") %}
<a class="pill" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.label | i18n({}, lang) }} <span aria-hidden="true">↗</span></a>
{% else %}
<a class="pill" href="{{ item.url }}">{{ item.label | i18n({}, lang) }}</a>
{% endif %}
{% endfor %}
</p>
{% elif b.type == "download" %}
<p class="download">
<a class="store" href="https://apps.apple.com/us/app/simplex-chat/id1605771084" target="_blank" rel="noopener">App Store</a>
<a class="store" href="https://play.google.com/store/apps/details?id=chat.simplex.app" target="_blank" rel="noopener">Google Play</a>
<a class="store alt" href="{{ langPrefix }}/fdroid/">F-Droid</a>
<a class="store alt" href="/downloads/">{{ "home-download-desktop" | i18n({}, lang) }}</a>
</p>
{% elif b.type == "questions" %}
<p class="questions">
{% for id in b.items %}
<a class="chip" href="#{{ id }}" data-intent="{{ id }}">{{ id | intentLabel | i18n({}, lang) }}</a>
{% endfor %}
</p>
{% endif %}
{% endmacro %}
