{% macro picture(image) -%}
<img{% if image.dark %} class="only-light"{% endif %} src="{{ image.src }}" alt="{{ image.alt }}" width="{{ image.w }}" height="{{ image.h }}" loading="lazy" decoding="async">
{%- if image.dark %}<img class="only-dark" src="{{ image.dark }}" alt="{{ image.alt }}" width="{{ image.w }}" height="{{ image.h }}" loading="lazy" decoding="async">{% endif %}
{%- endmacro %}

{% macro choice(option) -%}
{%- if option.url -%}
<a class="opt" href="{{ option.url }}" target="_blank" rel="noopener">{{ option.label }}<svg class="out" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11 11 5M6 5h5v5"/></svg></a>
{%- else -%}
<a class="opt{% if option.notice %} notice{% endif %}" href="/answers/{{ option.to }}/" data-to="{{ option.to }}">{{ option.label }}</a>
{%- endif -%}
{%- endmacro %}
